#!/usr/bin/env bash
# pre-push: mirror the CI gates so a red build never reaches origin.
#
# Runs the same checks as .github/workflows/{build,lint}.yml:
#   1. go build ./...                 — compile + //go:embed all:dist
#   2. golangci-lint run              — v2.10, same as lint.yml (covers gofumpt)
#   3. go test -short -failfast ./... — like build.yml, minus -race (that needs
#                                       a local gcc/cgo that isn't guaranteed)
#
# golangci-lint is used from PATH when present, otherwise `go run` fetches the
# pinned version (downloaded once into the module cache, then reused).
#
# A real contributing cause investigated this session: Go's default temp
# dir on this machine (TEMP/TMP) points OUTSIDE the repo, at
# D:\system_artefact\Temp, plausibly not covered by whatever antivirus
# exclusion covers the repo checkout — real-time AV scanning touching a
# just-closed sqlite/process-teardown file can delay Windows' handle release
# past even a generous bounded-retry. Confirmed empirically (an isolated
# repeat of a previously-flaky test passed 5/5 with TMP/TEMP redirected
# inside the repo checkout) — but redirecting TEMP *into* the actual git
# working tree has a real, demonstrated side effect: internal/config's
# TestLookupConfigs_BoundedByProject specifically asserts config-lookup does
# NOT climb past a project boundary, and with TempDir now nested inside this
# repo's own real .git, that assertion broke deterministically (same failure
# on every run, not flaky) — a self-inflicted regression, reverted. TEMP/TMP
# are therefore left at their normal system default here; a real fix would
# need either an admin-configured AV exclusion on the actual system temp
# path, or a redirect target that is demonstrably outside any git working
# tree — neither is something this hook can safely do unattended.
#
# What IS kept, defense-in-depth against the same root symptom (Windows
# handle-release lag under load): -p (package-level test parallelism)
# capped and -parallel (t.Parallel() subtest concurrency within a package
# binary) serialized, rather than left at Go's default (GOMAXPROCS, e.g.
# 16-way on a 16-thread box, for both knobs independently) — several
# packages (agent/cliprovider, agent/tools/mcp, internal/cmd) spawn real OS
# subprocesses / open sqlite handles as part of their own tests. Costs only
# wall-clock. Below that: a transparent retry-once of the whole test step,
# standard practice for rare environment-driven flakiness that survives the
# capping above — a genuine regression fails identically on both attempts,
# so this cannot mask real breakage. CI (ubuntu-latest) doesn't have this
# problem and is intentionally left at its own default.
#
# Bypass in an emergency with:  git push --no-verify
set -uo pipefail

# Keep in sync with golangci_version in .github/workflows/lint.yml.
GOLANGCI_VERSION="v2.10"

cd "$(git rev-parse --show-toplevel)" || exit 1

fail() { printf '\n\033[31m✗ pre-push: %s\033[0m\n' "$1" >&2; exit 1; }
step() { printf '\033[36m▸ %s\033[0m\n' "$1"; }

step "go build ./..."
go build ./... || fail "build failed"

step "golangci-lint run ($GOLANGCI_VERSION)"
if command -v golangci-lint >/dev/null 2>&1; then
	golangci-lint run || fail "lint failed"
else
	go run "github.com/golangci/golangci-lint/v2/cmd/golangci-lint@${GOLANGCI_VERSION}" run \
		|| fail "lint failed (ran via 'go run'; install golangci-lint for speed)"
fi

step "go test -short -failfast -p 4 -parallel 1 ./..."
if go test -short -failfast -p 4 -parallel 1 ./...; then
	printf '\033[32m(tests passed on the first attempt)\033[0m\n'
else
	printf '\033[33m⚠ tests failed once — retrying (known Windows handle-release flakiness, see comment above)\033[0m\n'
	go test -short -failfast -p 4 -parallel 1 ./... || fail "tests failed twice in a row — not the known flake, treat as real"
	printf '\033[33m(tests passed on retry)\033[0m\n'
fi

printf '\033[32m✓ pre-push checks passed\033[0m\n'
