#!/usr/bin/env bash
# pre-push: mirror the CI gates so a red build never reaches origin.
#
# Runs the same checks as .github/workflows/{build,lint}.yml:
#   1. go build ./...                 — compile + //go:embed all:dist
#   2. golangci-lint run              — v2.10, same as lint.yml (covers gofumpt),
#                                       once per GOOS in the CI matrix so
#                                       build-tagged files aren't skipped
#   3. go test -short -failfast ./... — like build.yml, minus -race (that needs
#                                       a local gcc/cgo that isn't guaranteed)
#
# golangci-lint is used from PATH when present, otherwise `go run` fetches the
# pinned version (downloaded once into the module cache, then reused).
#
# This session root-caused three genuine Windows-only test races (see git
# log for internal/agent/cliprovider/provider_test.go,
# internal/agent/tools/mcp/process_windows_test.go, and
# internal/cmd/models_use_test.go) — each fixed AT THE SPECIFIC TEST, not by
# slowing the whole suite down. (An earlier version of this hook also capped
# -p/-parallel globally as extra defense-in-depth; that made every push take
# 3-5x longer for no longer-necessary benefit once the actual tests were
# fixed, so it was removed — full default Go parallelism is used here again.)
# A transparent retry-once remains below as a cheap backstop for whatever
# rare environment-driven flakiness still slips through (AV scanning,
# genuine OS scheduling lag): a real regression fails identically on both
# attempts, so this cannot mask real breakage, and the common case (no
# flake) never pays for it.
#
# The retry is scoped to only the package(s) that actually failed (task
# #455, following up on task #450's test-speed investigation), not the
# whole `./...` suite — re-running everything used to mean a single flake
# anywhere re-paid the full suite's time twice, which mattered a lot more
# before task #450-#454 cut that time by ~50%+. If no failing package can
# be parsed out of the first attempt's output, this falls back to
# retrying the whole suite rather than silently skipping the retry.
#
# Bypass in an emergency with:  git push --no-verify
set -uo pipefail

# Keep in sync with golangci_version in .github/workflows/lint.yml.
GOLANGCI_VERSION="v2.10"

cd "$(git rev-parse --show-toplevel)" || exit 1

fail() { printf '\n\033[31m✗ pre-push: %s\033[0m\n' "$1" >&2; exit 1; }
step() { printf '\033[36m▸ %s\033[0m\n' "$1"; }

step "go build ./..."
go build ./... || fail "build failed"

step "golangci-lint run ($GOLANGCI_VERSION)"
gcl=""
if command -v golangci-lint >/dev/null 2>&1; then
	gcl="golangci-lint"
elif [ -x "$(go env GOPATH)/bin/golangci-lint" ]; then
	gcl="$(go env GOPATH)/bin/golangci-lint"
elif [ -x "$(go env GOPATH)/bin/golangci-lint.exe" ]; then
	gcl="$(go env GOPATH)/bin/golangci-lint.exe"
fi

if [ -n "$gcl" ]; then
	"$gcl" run || fail "lint failed"
else
	go run "github.com/golangci/golangci-lint/v2/cmd/golangci-lint@${GOLANGCI_VERSION}" run \
		|| fail "lint failed (ran via 'go run'; install golangci-lint for speed)"
fi

# Cross-GOOS lint. lint.yml runs on ubuntu, macos AND windows, but the pass
# above only ever sees the HOST's build tags — a file behind //go:build
# !windows is invisible from Windows, and vice versa. That is not
# hypothetical: a noctx finding in internal/session/track_unix_test.go
# sailed through a green pre-push here and turned the lint workflow red,
# which is the one thing this hook exists to prevent.
#
# `go run` cannot do this pass: with GOOS set it builds a foreign
# golangci-lint binary and then cannot exec it. So when no native binary is
# available this is skipped LOUDLY — silently covering only the host would
# read as "lint is green" while saying nothing about two thirds of the CI
# matrix.
if [ -n "$gcl" ]; then
	host_goos="$(go env GOHOSTOS)"
	for goos in linux darwin windows; do
		[ "$goos" = "$host_goos" ] && continue
		step "golangci-lint run — GOOS=$goos"
		GOOS="$goos" "$gcl" run || fail "lint failed for GOOS=$goos (CI lints all three)"
	done
else
	printf '\033[33m⚠ skipping the cross-GOOS lint passes — they need a native golangci-lint (go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@%s); CI still lints linux/macos/windows\033[0m\n' "$GOLANGCI_VERSION"
fi

step "go test -short -failfast ./..."
test_log="$(mktemp)"
trap 'rm -f "$test_log"' EXIT
if go test -short -failfast ./... 2>&1 | tee "$test_log"; then
	printf '\033[32m(tests passed on the first attempt)\033[0m\n'
else
	# Package(s) that actually reported FAIL, e.g.
	# "FAIL	github.com/.../internal/session	3.45s" -> the package path.
	failed_pkgs="$(grep -E '^FAIL[[:space:]]' "$test_log" | awk '{print $2}' | sort -u | tr '\n' ' ')"
	if [ -z "${failed_pkgs// /}" ]; then
		printf '\033[33m⚠ tests failed once — could not identify which package from the output, retrying the whole suite (known rare Windows flakiness, see comment above)\033[0m\n'
		go test -short -failfast ./... || fail "tests failed twice in a row — not the known flake, treat as real"
	else
		printf '\033[33m⚠ tests failed once in: %s — retrying just that/those package(s) (known rare Windows flakiness, see comment above)\033[0m\n' "$failed_pkgs"
		# shellcheck disable=SC2086
		go test -short -failfast $failed_pkgs || fail "tests failed twice in a row in $failed_pkgs — not the known flake, treat as real"
	fi
	printf '\033[33m(tests passed on retry)\033[0m\n'
fi

printf '\033[32m✓ pre-push checks passed\033[0m\n'
